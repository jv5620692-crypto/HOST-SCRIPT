-- Função Slider (Igual da foto)
local function slider(nome, order, valor, minV, maxV, callback)
    local b = Instance.new("Frame")
    b.Size = UDim2.new(1, 0, 0, 30)
    b.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    b.BorderSizePixel = 0
    b.LayoutOrder = order
    b.Parent = scroll

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, -10, 0, 15)
    txt.Position = UDim2.new(0, 5, 0, 2)
    txt.BackgroundTransparency = 1
    txt.Text = nome .. ": " .. valor
    txt.TextColor3 = Color3.fromRGB(200, 200, 200)
    txt.Font = Enum.Font.Gotham
    txt.TextSize = 10
    txt.TextXAlignment = Enum.TextXAlignment.Left
    txt.Parent = b

    local barBg = Instance.new("Frame")
    barBg.Size = UDim2.new(1, -10, 0, 6)
    barBg.Position = UDim2.new(0, 5, 0, 20)
    barBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    barBg.BorderSizePixel = 0
    barBg.Parent = b
    
    local barFill = Instance.new("Frame")
    barFill.Size = UDim2.new((valor-minV)/(maxV-minV), 0, 1, 0)
    barFill.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
    barFill.BorderSizePixel = 0
    barFill.Parent = barBg
    
    -- Lógica de arrastar
    local dragging = false
    barBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local mx = input.Position.X - barBg.AbsolutePosition.X
            local p = math.clamp(mx / barBg.AbsoluteSize.X, 0, 1)
            barFill.Size = UDim2.new(p, 0, 1, 0)
            local v = math.floor(minV + (maxV - minV) * p)
            txt.Text = nome .. ": " .. v
            callback(v)
        end
    end)
end

