local function isTargetable(plr)
    if plr == LP or DeadPlayers[plr] or not plr.Character then return false end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

-- Wall Check (Raycast)
local function checkVisible(part)
    if not Config.WallCheck then return true end
    local origin = Camera.CFrame.Position
    local diff = part.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LP.Character, Camera}
    local result = workspace:Raycast(origin, diff.Unit * diff.Magnitude, params)
    if result and result.Instance:IsDescendantOf(part.Parent) then return true end
    if not result then return true end
    return false
end

local function getClosest()
    local best, bd = nil, math.huge
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if isTargetable(plr) then
            local part = plr.Character:FindFirstChild(Config.MiraPeito and "UpperTorso" or "Head")
            if part and checkVisible(part) then
                local sp, on = Camera:WorldToScreenPoint(part.Position)
                if on then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    -- Considera o FOVSize
                    if d < bd and d <= Config.FOVSize then
                        bd = d
                        best = plr
                    end
                end
            end
        end
    end
    return best
end

local function watchDeaths(plr)
    plr.CharacterAdded:Connect(function(char)
        DeadPlayers[plr] = nil
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then hum.Died:Connect(function() DeadPlayers[plr] = true end) end
    end)
    plr.CharacterRemoving:Connect(function() DeadPlayers[plr] = true end)
end
for _, p in ipairs(Players:GetPlayers()) do watchDeaths(p) end
Players.PlayerAdded:Connect(watchDeaths)
Players.PlayerRemoving:Connect(function(p) DeadPlayers[p] = nil limparESP(p) end)

-- ESP System
local function limparESP(plr)
    if ESPObjs[plr] then ESPObjs[plr]:Destroy() ESPObjs[plr] = nil end
end

function criarESP(plr)
    if plr == LP or not plr.Character then return end
    limparESP(plr)
    local char = plr.Character
    local head = char:FindFirstChild("Head")
    if not head then return end

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 50, 0, 50)
    bb.StudsOffset = Vector3.new(0, 2.5, 0)
    bb.AlwaysOnTop = true
    bb.Adornee = head
    bb.Parent = char

    if Config.ESP_Nome then
        local n = Instance.new("TextLabel")
        n.Size = UDim2.new(1, 0, 0, 14)
        n.BackgroundTransparency = 1
        n.Text = plr.Name
        n.TextColor3 = Color3.fromRGB(255, 255, 255)
        n.TextStrokeTransparency = 0
        n.Font = Enum.Font.GothamBold
        n.TextSize = 11
        n.Parent = bb
    end

    if Config.ESP_Caixa then
        local box = Instance.new("Frame")
        box.Size = UDim2.new(1, -10, 2, 0)
        box.Position = UDim2.new(0, 5, 0, -10)
        box.BackgroundTransparency = 1
        box.Parent = bb
        local bs = Instance.new("UIStroke")
        bs.Color = Color3.fromRGB(255, 255, 255)
        bs.Thickness = 1
        bs.Parent = box
    end

    ESPObjs[plr] = bb
end

function atualizarESP()
    for _, p in ipairs(Players:GetPlayers()) do
        limparESP(p)
        if p ~= LP and (Config.ESP_Nome or Config.ESP_Caixa) then
            criarESP(p)
        end
    end
end

--// ============================================
--// LOOP PRINCIPAL
--// ============================================
RunService.RenderStepped:Connect(function()
    -- FOV Circle & Linhas
    if isDrawingSupported and Config.MostrarFOV then
        FovCircle.Visible = true
        FovCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        FovCircle.Radius = Config.FOVSize / 2
    elseif isDrawingSupported then
        FovCircle.Visible = false
    end

    local alvo = getClosest()
    if Config.ESP_Linha and isDrawingSupported and alvo then
        local part = alvo.Character:FindFirstChild("Head")
        if part then
            local sp, on = Camera:WorldToScreenPoint(part.Position)
            if on then
                LinhaInimigo.Visible = true
                LinhaInimigo.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                LinhaInimigo.To = Vector2.new(sp.X, sp.Y)
            end
        end
    elseif isDrawingSupported then
        LinhaInimigo.Visible = false
    end

    -- Speed
    if Config.Speed then
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = 22 end
    end

    -- Aimbot
    if Config.Aimbot and alvo then
        local part = alvo.Character:FindFirstChild(Config.MiraPeito and "UpperTorso" or "Head")
        if part then
            local newCF = CFrame.new(Camera.CFrame.Position, part.Position)
            local lerpFactor = Config.Suavidade / 100
            if Config.AimbotLegit then
                -- Se for legit, a suavidade é multiplicada
                lerpFactor = lerpFactor * 0.5
            end
            Camera.CFrame = Camera.CFrame:Lerp(newCF, lerpFactor)
        end
    end
end)

